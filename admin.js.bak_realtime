    status: "BUKA",
    tahunAjaran: "2026/2027",
    jadwal: "Gelombang 1 (Mei - Juni), Gelombang 2 (Juli)",
    jamPelayanan: "Senin - Jumat pukul 08.00 - 12.00 WIT",
    kuota: "1 Rombongan Belajar (28-30 siswa)",
